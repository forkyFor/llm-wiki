OLLAMA_URL=http://localhost:11434
CHAT_MODEL_NAME=qwen3:8b
INGEST_MODEL_NAME=qwen3:14b

# Semantic cache — embedding model (ollama pull nomic-embed-text, ~274 MB)
# EMBED_MODEL_NAME=nomic-embed-text
# CACHE_SIMILARITY_THRESHOLD=0.85   # 0.0–1.0, higher = stricter match
# CACHE_MAX_ENTRIES=500             # max risposte in memoria

# OCR backend: tesseract (default) | easyocr | got_ocr2 | ollama
# tesseract:  lightweight, good for clean scans [~50 MB]
# easyocr:    better accuracy, pip install easyocr [~120 MB auto-download]
# got_ocr2:   complex layouts, tables, multilingual — pip install transformers torch torchvision [~580 MB auto-download]
# ollama:     best quality (vision LLM), ollama pull minicpm-v [~5.5 GB]
OCR_BACKEND=tesseract
# OCR_MODEL_NAME=minicpm-v    # used only when OCR_BACKEND=ollama

OCR_DEVICE=cpu
RAW_DIR=raw
WIKI_DIR=wiki
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
